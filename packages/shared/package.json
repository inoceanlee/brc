{
    "name": "brc-shared",
    "description": "Better Remote Commander (BRC) shared protocol types and tool schemas",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node ../../scripts/script-diagnostics.mjs ../../scripts/build-package.mjs ."
